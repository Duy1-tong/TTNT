# =============================================================
# FILE CAU HINH MAU - HE THONG DIEM DANH SINH VIEN BANG KHUON MAT
# Sao chep file nay thanh ".env" va chinh sua theo may cua ban
# =============================================================

# ----- Cau hinh ket noi MySQL/MariaDB (XAMPP) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diem_danh_khuon_mat
DB_USER=root
DB_PASSWORD=

# ----- Cau hinh bao mat -----
# Khoa bi mat dung de ma hoa embedding khuon mat (32 ky tu, tu sinh neu bo trong)
KHOA_BI_MAT_EMBEDDING=

# So lan dang nhap sai toi da truoc khi khoa tai khoan
SO_LAN_DANG_NHAP_SAI_TOI_DA=5

# Thoi gian khoa tai khoan (phut) sau khi dang nhap sai qua so lan cho phep
THOI_GIAN_KHOA_TAI_KHOAN_PHUT=15

# ----- Cau hinh AI nhan dien khuon mat -----
# Nguong do tuong dong (cosine similarity) de xac dinh la cung mot nguoi (0.0 - 1.0)
NGUONG_DO_TUONG_DONG=0.45

# Thu muc chua model AI (YOLO, InsightFace ...)
THU_MUC_MODEL=app/tai_nguyen/model

# Chi so camera mac dinh (0 la webcam mac dinh cua may)
CHI_SO_CAMERA_MAC_DINH=0

# ----- Cau hinh ung dung -----
TEN_UNG_DUNG=He Thong Diem Danh Sinh Vien Bang Khuon Mat
MUC_GHI_LOG=INFO
THU_MUC_NHAT_KY=nhat_ky
THU_MUC_BAO_CAO=bao_cao
THU_MUC_ANH_SINH_VIEN=du_lieu/anh_sinh_vien
THU_MUC_DU_LIEU_KHUON_MAT=du_lieu/khuon_mat
